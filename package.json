{
  "name": "shopping-list",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "client:dev": "pnpm --filter client dev",
    "client:build": "pnpm --filter client build",
    "server:dev": "pnpm --filter server dev",
    "server:deploy": "pnpm --filter server cf:deploy",
    "build": "pnpm run client:build",
    "deploy": "pnpm run build && pnpm run server:deploy",
    "db:generate": "pnpm --filter lib db:generate",
    "db:migrate:local": "wrangler d1 migrations apply shopping-list --local --config=server/wrangler.json",
    "db:migrate:remote": "wrangler d1 migrations apply shopping-list --remote --config=server/wrangler.json",
    "db:execute:local": "wrangler d1 execute shopping-list --local --config=server/wrangler.json",
    "db:execute:remote": "wrangler d1 execute shopping-list --remote --config=server/wrangler.json"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "typescript": "catalog:",
    "wrangler": "^4.10.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}

{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",

	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"include": ["server/src", "client/src", "lib"],
		"ignore": [
			"node_modules",
			"dist",
			"build",
			"public",
			"./package.json",
			"legacy"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineEnding": "lf",
		"attributePosition": "multiline"
	},
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noNonNullAssertion": "error",
				"useNamingConvention": {
					"level": "error",
					"options": {
						"strictCase": true,
						"conventions": [
							{
								"selector": {
									"kind": "const"
								},
								"formats": ["CONSTANT_CASE", "snake_case"]
							},
							{
								"selector": {
									"kind": "variable"
								},
								"formats": ["snake_case"]
							},
							{
								"selector": {
									"kind": "function"
								},
								"formats": ["snake_case"]
							},
							{
								"selector": {
									"kind": "functionParameter"
								},
								"formats": ["snake_case"]
							},
							{
								"selector": {
									"kind": "objectLiteralMember"
								},
								"formats": ["snake_case"]
							},
							{
								"selector": {
									"kind": "class"
								},
								"formats": ["PascalCase"]
							},
							{
								"selector": {
									"kind": "classMember"
								},
								"formats": ["snake_case"]
							},
							{
								"selector": {
									"kind": "typeAlias"
								},
								"formats": ["PascalCase"]
							},
							{
								"selector": {
									"kind": "interface"
								},
								"formats": ["PascalCase"]
							},
							{
								"selector": {
									"kind": "typeMember"
								},
								"formats": ["snake_case"]
							}
						]
					}
				}
			},
			"a11y": {
				"all": true
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"trailingCommas": "all"
		}
	}
}

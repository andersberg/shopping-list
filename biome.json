{
	"$schema": "https://biomejs.dev/schemas/2.3.1/schema.json",

	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/server/src/**",
			"**/client/src/**",
			"**/lib/**",
			"!**/node_modules",
			"!**/dist",
			"!**/build",
			"!**/public",
			"!package.json",
			"!**/legacy"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineEnding": "lf",
		"attributePosition": "multiline"
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noNonNullAssertion": "error",
				"useNamingConvention": {
					"level": "error",
					"options": {
						"strictCase": true,
						"requireAscii": false,
						"conventions": [
							{
								"selector": {
									"kind": "const"
								},
								"formats": ["CONSTANT_CASE", "snake_case"]
							},
							{
								"selector": {
									"kind": "variable"
								},
								"formats": ["snake_case"]
							},
							{
								"selector": {
									"kind": "function"
								},
								"formats": ["PascalCase", "camelCase", "snake_case"]
							},
							{
								"selector": {
									"kind": "class"
								},
								"formats": ["PascalCase"]
							},
							{
								"selector": {
									"kind": "classMember"
								},
								"formats": ["snake_case"]
							},
							{
								"selector": {
									"kind": "objectLiteralProperty"
								},
								"formats": ["camelCase", "snake_case"]
							},
							{
								"selector": {
									"kind": "typeAlias"
								},
								"formats": ["PascalCase"]
							},
							{
								"selector": {
									"kind": "interface"
								},
								"formats": ["PascalCase"]
							},
							{
								"selector": {
									"kind": "typeMember"
								},
								"formats": ["snake_case", "PascalCase"]
							}
						]
					}
				}
			},
			"correctness": {
				"noUnusedVariables": "info"
			},
			"a11y": {}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"trailingCommas": "all"
		}
	}
}
